# Adres wdrożonej aplikacji i klucz agenta (ten sam co AGENT_API_KEY w Vercel)
TRAINSTACK_URL=https://twoja-domena.vercel.app
AGENT_API_KEY=change-me
# Konto TrainStack, do którego trafiają aktywności (e-mail lub id)
TRAINSTACK_USER=jan@example.com

# Dane logowania do Garmin Connect — potrzebne tylko przy pierwszym uruchomieniu
# (i po wygaśnięciu tokenów); tokeny sesji lądują w GARMIN_TOKEN_DIR.
GARMIN_EMAIL=jan@example.com
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=.garmin-tokens

# Opcjonalnie
# Ile dni wstecz pobierać przy pierwszym uruchomieniu (potem od ostatniej synchronizacji)
SYNC_DAYS=14
# Maks. liczba aktywności pobieranych z Garmina na jedno uruchomienie
SYNC_LIMIT=100
# Strefa czasowa dla dat lokalnych (domyślnie Europe/Warsaw)
SYNC_TZ=Europe/Warsaw
# Dyscyplina dla aktywności, których typu nie da się rozpoznać (ext_id, np. "gym");
# bez niej takie aktywności są pomijane i wypisywane w raporcie
SYNC_DEFAULT_DISCIPLINE=
